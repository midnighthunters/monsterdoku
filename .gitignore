# Ignore everything by default
*

# Keep repository Git configuration tracked.
!.gitignore
!.gitattributes

# Keep all Unity source assets and their .meta files.
# Generated build output and Unity caches remain ignored by the default rule above.
!Assets/
!Assets/**

# Keep the package manifest and lockfile so CI resolves the same dependencies.
!Packages/
!Packages/**

# Keep serialized Unity project and iOS Player settings.
!ProjectSettings/
!ProjectSettings/**

# Keep repository automation and CI configuration.
!.github/
!.github/**

# Keep the committed iOS Xcode export so GitHub's macOS runner can archive it directly.
!Build/
!Build/ios/
!Build/ios/**
